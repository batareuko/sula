<Window x:Class="AionMeter.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:vm="clr-namespace:AionMeter.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="Root"
        Title="1 HP Overlay" Width="470" Height="540" MinWidth="340" MinHeight="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <c:VisibleIf x:Key="VisibleIf" />

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
        </Storyboard>

        <!-- Row size (Settings → Overlay → Row size, Ctrl + wheel over the rows): OverlayWindow.ApplyRowSize replaces
             these. Value columns share fixed widths so the header labels sit exactly over the numbers. -->
        <GridLength x:Key="ColRankWidth">30</GridLength>
        <GridLength x:Key="ColGlyphWidth">32</GridLength>
        <GridLength x:Key="ColDpsWidth">104</GridLength>
        <GridLength x:Key="ColDamageWidth">74</GridLength>
        <GridLength x:Key="ColShareWidth">68</GridLength>
        <sys:Double x:Key="RowHeight">42</sys:Double>
        <!-- 1 HP: header, boss bar and footer sizes; the compact layout replaces them (OverlayWindow.ApplyCompact) -->
        <Thickness x:Key="CardPadding">20,14,20,10</Thickness>
        <sys:Double x:Key="HeaderHeight">30</sys:Double>
        <sys:Double x:Key="ClockFont">27</sys:Double>
        <Thickness x:Key="TitleRowMargin">0,8,0,0</Thickness>
        <sys:Double x:Key="PortraitBox">74</sys:Double>
        <sys:Double x:Key="PortraitRing">58</sys:Double>
        <sys:Double x:Key="PortraitImage">68</sys:Double>
        <sys:Double x:Key="SkullSize">26</sys:Double>
        <Thickness x:Key="TitleTextMargin">14,0,8,0</Thickness>
        <sys:Double x:Key="TitleFontSize">25</sys:Double>
        <sys:Double x:Key="DetailFont">12.5</sys:Double>
        <sys:Double x:Key="TopHitFont">25</sys:Double>
        <sys:Double x:Key="TopHitLabelFont">9.5</sys:Double>
        <sys:Double x:Key="BossBarHeight">34</sys:Double>
        <Thickness x:Key="BossBarMargin">0,14,0,0</Thickness>
        <sys:Double x:Key="BossFont">14.5</sys:Double>
        <Thickness x:Key="PartyMargin">0,12,0,0</Thickness>
        <Thickness x:Key="FooterMargin">0,8,0,0</Thickness>
        <Thickness x:Key="NetMargin">0,6,12,0</Thickness>
        <sys:Double x:Key="FooterFont">12</sys:Double>
        <Thickness x:Key="RowMargin">0,0,0,6</Thickness>
        <sys:Double x:Key="RowGlossHeight">19</sys:Double>
        <sys:Double x:Key="RowNameFont">16.5</sys:Double>
        <sys:Double x:Key="RowNumberFont">16</sys:Double>
        <sys:Double x:Key="RowGlyphSize">30</sys:Double>
        <sys:Double x:Key="RowRankSize">24</sys:Double>
        <sys:Double x:Key="RowRankFont">13</sys:Double>
        <sys:Double x:Key="ColHeaderFont">11</sys:Double>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource ColHeaderFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#C9D0DC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Help" />
        </Style>

        <!-- DPS, total damage and share: one size, white -->
        <Style x:Key="RowNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowNumberFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- 1 HP modern style: cool slate card, indigo → teal accent, flat surfaces, no shadows or glows -->
        <SolidColorBrush x:Key="Cream" Color="#EEF2F8" />
        <SolidColorBrush x:Key="Soft" Color="#A8B2C6" />
        <SolidColorBrush x:Key="Accent" Color="#6E8BFF" />
        <SolidColorBrush x:Key="Accent2" Color="#2DD4BF" />

        <SolidColorBrush x:Key="CardFrame" Color="#26FFFFFF" />
        <LinearGradientBrush x:Key="AccentLine" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#006E8BFF" Offset="0" />
            <GradientStop Color="#6E8BFF" Offset="0.3" />
            <GradientStop Color="#2DD4BF" Offset="0.7" />
            <GradientStop Color="#002DD4BF" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TopHitBrush" Color="#5EEAD4" />

        <LinearGradientBrush x:Key="HpFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E11D48" Offset="0" />
            <GradientStop Color="#FB7185" Offset="1" />
        </LinearGradientBrush>

        <TextDecorationCollection x:Key="SelfUnderline">
            <TextDecoration Location="Underline" PenOffset="3">
                <TextDecoration.Pen>
                    <Pen Brush="#A5B8FF" Thickness="1.6" />
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>

        <Style x:Key="FooterLink" TargetType="Button">
            <Setter Property="Foreground" Value="#9DB0FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="P" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The footer's boss timer button: a filled accent pill so it reads as a button, not a link -->
        <Style x:Key="TimersPill" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="10,3,11,3" BorderThickness="1" BorderBrush="Transparent" Background="#6E8BFF">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8299FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "A new version is out": a slim green banner above the footer, only while an update is available -->
        <Style x:Key="UpdateBannerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D2FAE6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,4,10,4" BorderThickness="1" BorderBrush="#803DD68C" Background="#2A3DD68C">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DD68C" />
                                <Setter TargetName="Bd" Property="Background" Value="#403DD68C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One player: a full-height class-coloured bar (AionFlex style) with place medal, emblem, name,
             DPS in a light class tint, total damage and share -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:RowViewModel}">
            <Grid Height="{DynamicResource RowHeight}" Margin="{DynamicResource RowMargin}" Cursor="Hand" ToolTip="{Binding Tooltip}"
                  Background="Transparent" MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick">
                <!-- track -->
                <Border CornerRadius="6" Background="#14FFFFFF" />
                <!-- fill -->
                <Border CornerRadius="6" Background="{Binding FillBrush}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Fill}" />
                    </Border.RenderTransform>
                </Border>
                <Border x:Name="Hover" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" />
                <!-- your own row -->
                <Border CornerRadius="6" BorderThickness="1.5" BorderBrush="{StaticResource Accent}"
                        Visibility="{Binding IsSelf, Converter={StaticResource VisibleIf}}" />

                <Grid Margin="8,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ColRankWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColGlyphWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource ColDpsWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColDamageWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColShareWidth}" />
                    </Grid.ColumnDefinitions>

                    <!-- Place: medal for the top three, ringed number for the rest -->
                    <Grid Width="{DynamicResource RowRankSize}" Height="{DynamicResource RowRankSize}" HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <Ellipse Fill="{Binding RankBackground}" Stroke="{Binding RankBorder}" StrokeThickness="1.2" />
                        <TextBlock Text="{Binding RankText}" FontFamily="{StaticResource NumberFont}" FontSize="{DynamicResource RowRankFont}"
                                   FontWeight="Bold" Foreground="{Binding RankForeground}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,0,0,1" />
                    </Grid>

                    <c:ClassGlyph Grid.Column="1" Class="{Binding Class}" OnBar="True" Width="{DynamicResource RowGlyphSize}"
                                  Height="{DynamicResource RowGlyphSize}" HorizontalAlignment="Left" />

                    <DockPanel Grid.Column="2" LastChildFill="False" Margin="4,0,8,1">
                        <TextBlock x:Name="NameText" DockPanel.Dock="Left" Text="{Binding Name}" FontSize="{DynamicResource RowNameFont}" FontWeight="Bold"
                                   Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <!-- 1 HP: combat power right after the name (party list in the game, else the site's gear lookup) -->
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Gear}" FontFamily="{StaticResource NumberFont}" FontSize="11"
                                   FontWeight="SemiBold" Foreground="#C8FFF6" Opacity="0.85" VerticalAlignment="Center" Margin="7,1,0,0" />
                    </DockPanel>

                    <TextBlock Grid.Column="3" Text="{Binding Dps}" Style="{StaticResource RowNumber}" />
                    <TextBlock Grid.Column="4" Text="{Binding Damage}" Style="{StaticResource RowNumber}" />
                    <TextBlock Grid.Column="5" Text="{Binding Share}" Style="{StaticResource RowNumber}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="BorderBrush" Value="#44FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter TargetName="NameText" Property="TextDecorations" Value="{StaticResource SelfUnderline}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="4">
        <!-- Card -->
        <Border x:Name="Frame" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource CardFrame}">
            <Border.Background>
                <SolidColorBrush x:Name="FrameBackground" Color="#0E1320" Opacity="0.92" />
            </Border.Background>
        </Border>
        <Border Height="1.5" VerticalAlignment="Top" Margin="24,0" Background="{StaticResource AccentLine}" IsHitTestVisible="False" />

        <Grid Margin="{DynamicResource CardPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Label row (toolbar appears on hover) + timer -->
            <Grid x:Name="Header" Background="Transparent" Height="{DynamicResource HeaderHeight}">
                <StackPanel x:Name="LabelPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="1,0,9,0" Fill="{Binding HeaderBrush}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="PulseBegin" Storyboard="{StaticResource Pulse}" />
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PulseBegin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding HeaderLabel}" Foreground="{Binding HeaderBrush}" FontSize="11.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="Toolbar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Button Style="{StaticResource Chip}" Content="{Binding ModeLabel}" Click="Mode_Click" Margin="0,0,6,0"
                            ToolTip="Boss only / everything you hit" />
                    <Button Style="{StaticResource Chip}" Content="{Binding PartyLabel}" Click="Party_Click" Margin="0,0,6,0"
                            ToolTip="{Binding PartyTip}" />
                    <Button Style="{StaticResource Chip}" Content="{Binding LanguageCode}" Click="Language_Click" Margin="0,0,6,0"
                            ToolTip="{Binding T.SwitchLanguage}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE81C;" Click="Segments_Click" ToolTip="Fight segments" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE121;" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" />
                    <Button x:Name="RestartButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Restart_Click" />
                    <ToggleButton x:Name="LockButton" Style="{StaticResource IconToggle}" Click="Lock_Click" ToolTip="Lock position">
                        <TextBlock x:Name="LockGlyph" Text="&#xE785;" />
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings" />
                    <Slider x:Name="OpacitySlider" Style="{StaticResource GoldSlider}" Width="56" Minimum="0.15" Maximum="1" Margin="6,0,4,0"
                            ValueChanged="Opacity_Changed" VerticalAlignment="Center" ToolTip="Background opacity" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Hide_Click" ToolTip="Hide (Ctrl+Shift+D)" />
                </StackPanel>

                <TextBlock x:Name="ClockText" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Clock}"
                           FontFamily="{StaticResource NumberFont}" FontWeight="Bold" FontSize="{DynamicResource ClockFont}" Foreground="{StaticResource Cream}"
                           />

                <!-- 1 HP dynamic card, out of combat: your name and combat power, then ping and packet loss -->
                <Grid x:Name="MiniLine" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="MiniPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="MiniStatus" Width="7" Height="7" Margin="1,0,8,0" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="MiniName" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Cream}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        <Border x:Name="MiniPowerBox" Margin="9,0,0,0" Padding="7,1,8,1" CornerRadius="5" Background="#262DD4BF" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,5,0" Foreground="#5EEAD4"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="MiniPower" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Bold" Foreground="#BFF7EE"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="MiniNet" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="10,0,2,0" Background="Transparent">
                        <Ellipse x:Name="MiniNetDot" Width="6" Height="6" Fill="{StaticResource TextMute}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="MiniNetText" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="SemiBold" Foreground="#C9D2E0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Portrait, title, top hit -->
            <Grid x:Name="TitleRow" Grid.Row="1" Margin="{DynamicResource TitleRowMargin}" Background="Transparent"
                  MouseWheel="Title_MouseWheel" ToolTip="Scroll to step through fights">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="{DynamicResource PortraitBox}" Height="{DynamicResource PortraitBox}" VerticalAlignment="Center">
                    <Ellipse Width="{DynamicResource PortraitRing}" Height="{DynamicResource PortraitRing}" Stroke="#556E8BFF" StrokeThickness="1.5"
                             Fill="#1A2133" />
                    <Path Data="M12 3 C7 3 4 6.5 4 11 C4 14 5.5 15.5 7 16.5 L7 19 L9.5 19 L9.5 17.5 L11 17.5 L11 19 L13 19 L13 17.5 L14.5 17.5 L14.5 19 L17 19 L17 16.5 C18.5 15.5 20 14 20 11 C20 6.5 17 3 12 3 Z M8.8 9.8 A1.9 1.9 0 1 0 8.81 9.8 Z M15.2 9.8 A1.9 1.9 0 1 0 15.21 9.8 Z"
                          Fill="#8FA3FF" Stretch="Uniform" Width="{DynamicResource SkullSize}" Height="{DynamicResource SkullSize}"
                          Visibility="{Binding HasPortrait, Converter={StaticResource VisibleIf}, ConverterParameter=!}" />
                    <!-- Boss portrait in a gold ring -->
                    <Grid Width="{DynamicResource PortraitImage}" Height="{DynamicResource PortraitImage}" Visibility="{Binding HasPortrait, Converter={StaticResource VisibleIf}}">
                        <Ellipse Fill="#1A2133" />
                        <Ellipse Margin="2">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" AlignmentY="Top" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="1.5" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="{DynamicResource TitleTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadFont}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold"
                               Foreground="{StaticResource Cream}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="1,2,0,0">
                        <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource DetailFont}" Foreground="{StaticResource Soft}" TextTrimming="CharacterEllipsis"
                                  
                                   VerticalAlignment="Center" />
                        <!-- Your place in the ranking -->
                        <Border Margin="8,0,0,0" Padding="6,1,7,1" CornerRadius="5" VerticalAlignment="Center"
                                Background="{Binding SelfPlaceBrush}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1"
                                ToolTip="{Binding T.YourPlace}"
                                Visibility="{Binding SelfPlace, Converter={StaticResource VisibleIf}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="0,1,4,0"
                                           Foreground="{Binding SelfPlaceForeground}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelfPlace}" FontFamily="{StaticResource NumberFont}" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{Binding SelfPlaceForeground}" />
                            </StackPanel>
                        </Border>
                        <!-- 1 HP: your record on this boss, your place in the guild rating -->
                        <Border Margin="6,0,0,0" Padding="6,1,7,1" CornerRadius="5" VerticalAlignment="Center" Background="#2A3DD68C"
                                BorderBrush="Transparent" BorderThickness="1" ToolTip="{Binding RecordTip}"
                                Visibility="{Binding Record, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding Record}" FontSize="11.5" FontWeight="Bold" Foreground="#BFF5D6" />
                        </Border>
                        <Border Margin="6,0,0,0" Padding="6,1,7,1" CornerRadius="5" VerticalAlignment="Center" Background="#336E8BFF"
                                BorderBrush="Transparent" BorderThickness="1" ToolTip="{Binding GuildTip}"
                                Visibility="{Binding Guild, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding Guild}" FontSize="11.5" FontWeight="Bold" Foreground="#C7D2FF" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="{Binding TopHitBy}"
                            Visibility="{Binding TopHit, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="{Binding TopHit}" FontFamily="{StaticResource NumberFont}" FontWeight="Bold" FontSize="{DynamicResource TopHitFont}"
                               Foreground="{StaticResource TopHitBrush}" HorizontalAlignment="Center">
                    </TextBlock>
                    <TextBlock Text="{Binding T.TopHit}" FontSize="{DynamicResource TopHitLabelFont}" FontWeight="Bold" Foreground="#7FD9CB" HorizontalAlignment="Center"
                               Margin="0,-2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Boss HP -->
            <Grid Grid.Row="2" Height="{DynamicResource BossBarHeight}" Margin="{DynamicResource BossBarMargin}" Visibility="{Binding HasBoss, Converter={StaticResource VisibleIf}}">
                <Border CornerRadius="6" Background="#2A1420" />
                <Border CornerRadius="6" Background="{StaticResource HpFill}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding BossHpFraction}" />
                    </Border.RenderTransform>
                </Border>
                <Grid Margin="14,0">
                    <TextBlock Text="{Binding BossHpText}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="{DynamicResource BossFont}"
                               Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BossPercent}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="{DynamicResource BossFont}"
                               Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Party -->
            <Grid x:Name="PartyRow" Grid.Row="3" Margin="{DynamicResource PartyMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column labels (same widths as the rows below) -->
                <Grid Margin="8,0,14,5" Visibility="{Binding HasData, Converter={StaticResource VisibleIf}}"
                     >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ColRankWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColGlyphWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource ColDpsWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColDamageWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColShareWidth}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Style="{StaticResource ColHeader}" Width="{DynamicResource RowRankSize}" TextAlignment="Center"
                               HorizontalAlignment="Left" ToolTip="{Binding T.TipPlace}" />
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding T.ColPlayer}" Style="{StaticResource ColHeader}" />
                    <TextBlock x:Name="HeadDps" Grid.Column="3" Text="{Binding T.ColDps}" Style="{StaticResource ColHeader}" TextAlignment="Right"
                               ToolTip="{Binding T.TipDps}" />
                    <TextBlock x:Name="HeadDamage" Grid.Column="4" Text="{Binding T.ColDamage}" Style="{StaticResource ColHeader}" TextAlignment="Right"
                               ToolTip="{Binding T.TipDamage}" />
                    <TextBlock x:Name="HeadShare" Grid.Column="5" Text="{Binding T.ColShare}" Style="{StaticResource ColHeader}" TextAlignment="Right"
                               ToolTip="{Binding T.TipShare}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Padding="10,4,7,0" Margin="-10,-4,-7,0" PreviewMouseWheel="Rows_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                </ScrollViewer>
                <TextBlock Grid.RowSpan="2" Text="{Binding T.EmptyParty}" FontSize="12"
                           Foreground="#6B7590" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding HasData, Converter={StaticResource VisibleIf}, ConverterParameter=!}" />
            </Grid>

            <!-- Footer -->
            <StackPanel x:Name="Footer" Grid.Row="4" Margin="{DynamicResource FooterMargin}">
                <!-- New version on GitHub: a slim banner until it is installed, skipped or closed for this session -->
                <Grid x:Name="UpdateBanner" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource UpdateBannerButton}" Click="Update_Click" ToolTip="{Binding T.TipUpdate}">
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Click="UpdateBannerClose_Click" Margin="4,0,8,0"
                            VerticalAlignment="Center" ToolTip="{Binding T.UpdateLater}" />
                </Grid>
                <!-- 1 HP dynamic card: boss timers and reminders (Rift, reset) stay on, the rest shows on hover -->
                <Grid x:Name="RemindRow" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource TimersPill}" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE121;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimersLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="RemindText" Grid.Column="1" FontSize="{DynamicResource FooterFont}" Foreground="#B4BCCB" Margin="10,0,2,0"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Background="Transparent" />
                </Grid>
                <Grid x:Name="StatusRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Status}">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,7,0" />
                        <TextBlock x:Name="FooterText" FontSize="{DynamicResource FooterFont}" Foreground="#B4BCCB" TextTrimming="CharacterEllipsis"
                                   />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                        <!-- Boss timers: always visible, shows the next respawn -->
                        <Button x:Name="StatusTimers" Style="{StaticResource TimersPill}" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE121;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TimersLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FooterLink}" Content="{Binding T.OpenFight}" Click="Details_Click" />
                        <Button Style="{StaticResource FooterLink}" Click="Segments_Click">
                            <TextBlock><Run Text="{Binding T.Fights, Mode=OneWay}" /><Run Text=" " /><Run Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" /></TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- 1 HP: ping / packet loss of the game connection, Rift and daily reset -->
                <Grid x:Name="NetRow" Margin="{DynamicResource NetMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="NetPanel" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Ellipse x:Name="NetDot" Width="6" Height="6" Fill="{StaticResource TextMute}" Margin="0,0,7,0" />
                        <TextBlock x:Name="NetText" FontSize="{DynamicResource FooterFont}" Foreground="#B4BCCB" TextTrimming="CharacterEllipsis"
                                   />
                    </StackPanel>
                    <TextBlock x:Name="ScheduleText" Grid.Column="1" FontSize="{DynamicResource FooterFont}" Foreground="#B4BCCB" Margin="10,0,0,0"
                               Background="Transparent" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Resize grip -->
        <Thumb x:Name="ResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
               Cursor="SizeNWSE" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Path Data="M12 2 L2 12 M12 6 L6 12 M12 10 L10 12" Stroke="#556E8BFF" StrokeThickness="1.3" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
