<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AionMeter.Core\AionMeter.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>1HP-Overlay</AssemblyName>
    <RootNamespace>AionMeter.App</RootNamespace>
    <Product>1 HP Overlay</Product>
    <AssemblyTitle>1 HP Overlay</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.13.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, Brush... keep WinForms explicit (tray icon only). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 1 HP: the one-file exe (CI: -p:PublishSingleFile=true -p:WatcherExe=…) carries 1HP-Watcher.exe inside; the data
       folder and WPF's native libraries unpack with it to a temp folder on the first start. -->
  <ItemGroup Condition="'$(WatcherExe)' != ''">
    <EmbeddedResource Include="$(WatcherExe)" LogicalName="1HP-Watcher.exe" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
